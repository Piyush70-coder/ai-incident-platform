SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Database (PostgreSQL in production; SQLite fallback when these are empty)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis/Celery (leave CELERY_* empty to use REDIS_URL; do not set empty CELERY_BROKER_URL in .env
# or Celery may default to RabbitMQ/amqp — settings.py now treats empty as "unset")
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
